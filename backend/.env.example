# Copy this file to .env and adjust the values.
# NEVER commit your real .env (it is already gitignored).
#
# Generate a SECRET_KEY with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"

SECRET_KEY=change-me-generate-with-django-secret-key
DATABASE_URL=postgres://postgres:postgres@db:5432/attend_db

# Set to False in production and serve over HTTPS.
DJANGO_DEBUG=True

# Comma-separated hosts allowed to reach the app.
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated allowed CORS origins (browsers only).
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Convenience flag for local dev. Set to False in production.
CORS_ALLOW_ALL_ORIGINS=True

# Required only when the app is served from a different origin (e.g. a domain).
CSRF_TRUSTED_ORIGINS=

# Enable secure cookies only when serving over HTTPS in production.
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
